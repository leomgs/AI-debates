# Copiar a .env y completar. Ver shared/config/env.schema.ts para la
# validación — el proyecto no arranca si falta alguna de las requeridas.

DATABASE_URL="file:./dev.db"

# Única requerida para arrancar (ver env.schema.ts). Las demás son opcionales
# hasta tener una suscripción adecuada — ModelProviderFactory tira error
# recién si algo intenta resolver un provider cuya key falta.
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
# Generar gratis en https://openrouter.ai/settings/keys (free tier, sin
# tarjeta). ModelProviderFactory sortea entre 2 modelos :free validados
# manualmente contra la API real (decision-log.md 2026-09-08).
OPENROUTER_API_KEY=

# Opcional según el wrapper de TTS que uses
GOOGLE_TTS_API_KEY=

# Requerida — proveedor de búsqueda de ResearchModule. Generar en
# https://app.tavily.com (free tier: 1000 créditos/mes, sin tarjeta).
TAVILY_API_KEY=

# Opcionales — límites de free tier de Google para LlmRateLimiterService.
# Default 15/500 si no se setean (valor vigente hoy, ver ModelProviderFactory).
GOOGLE_RPM_LIMIT=15
GOOGLE_RPD_LIMIT=500

# Opcionales — límites reales del free tier de OpenRouter (20 RPM fijo;
# 50/día sin créditos comprados nunca, 1000/día si se compró $10+ alguna vez).
# Default conservador (sin créditos) si no se setean.
OPENROUTER_RPM_LIMIT=20
OPENROUTER_RPD_LIMIT=50

# TtsModule — motor activo para todo el proceso (LOCAL/GOOGLE_TTS/OPENROUTER).
# Default LOCAL si no se setea: sin key, sin costo (decision-log.md #19/#20).
TTS_PROVIDER=LOCAL
# Carpeta base de audio generado (AC 6.1) — gitignoreada.
AUDIO_STORAGE_DIR=./outputs/audios

PORT=3000
