# Copiar a .env y completar. Ver shared/config/env.schema.ts para la
# validación — el proyecto no arranca si falta alguna de las requeridas.

DATABASE_URL="file:./dev.db"

# Única requerida para arrancar (ver env.schema.ts). Las demás son opcionales
# hasta tener una suscripción adecuada — ModelProviderFactory tira error
# recién si algo intenta resolver un provider cuya key falta.
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Opcional según el wrapper de TTS que uses
GOOGLE_TTS_API_KEY=

PORT=3000
