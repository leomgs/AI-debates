// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

// =========================================================================
// 0. ENUMS
// (Soportados en SQLite desde Prisma 6.2 — validados a nivel de Prisma ORM)
// =========================================================================

// Feature 4: única fuente de verdad del ciclo de vida completo.
// Topic y Debate NO tienen status propio: se deriva consultando el Episode.
enum EpisodeStatus {
  CREATED
  RESEARCHING
  READY_FOR_DEBATE
  DEBATING
  JUDGING
  PENDING_REVIEW
  APPROVED
  CANCELLED
  FAILED
  GENERATING_AUDIO
  READY_FOR_RENDER
  RENDERING
  COMPLETED
  REQUIRES_HUMAN_REVIEW
}

enum CheckpointReason {
  INSUFFICIENT_EVIDENCE
  USAGE_LIMIT_EXCEEDED
  MAX_REVISIONS_EXCEEDED
  VALIDATION_INCONSISTENCY
  // Cuota RPD del provider de LLM agotada (LlmRateLimiterService) — distinto
  // de USAGE_LIMIT_EXCEEDED, que es el presupuesto propio del episodio
  // (EpisodeUsage vs maxLlmCalls), no la cuota externa del provider.
  PROVIDER_QUOTA_EXCEEDED
  // Spec 004, D15 (ADR 0002 punto 4): falta la voz de un agente para el
  // idioma del episodio y el proveedor activo en la fase de audio. Se
  // reanuda con body vacío después de cargar la voz. En SQLite el enum es
  // TEXT: agregar el valor no lleva SQL.
  VOICE_NOT_CONFIGURED
}

// Spec 004 (D3, ADR 0002 punto 1): idioma del debate, compartido por
// Episode.language y AgentVoice.language. Mismo enum que
// DebateLanguageSchema de packages/contracts. Agregar un idioma requiere
// migración a propósito (también exige instrucción de idioma y voces).
enum DebateLanguage {
  ES
  EN
  PT
}

// Extensible a propósito: nuevos tipos de ronda = nuevos formatos de debate
// sin tocar el resto del modelo.
enum RoundType {
  OPENING
  REBUTTAL
  CROSS_EXAMINATION
}

enum ArgumentStatus {
  DRAFT
  OFFICIAL
  REJECTED
}

enum ArgumentOrigin {
  AI_GENERATED
  HUMAN_EDITED
}

enum ArgumentHistoryStatus {
  REJECTED
  SUPERSEDED
}

enum ClaimType {
  FACTUAL
  OPINION
  PREDICTION
  SUBJECTIVE
}

enum FactCheckVeracity {
  TRUE
  FALSE
  MISLEADING
  UNSUPPORTED
  CONTESTED
}

enum AudioProvider {
  ELEVENLABS
  OPENAI
  GOOGLE_TTS
  LOCAL
  // 3 proveedores seleccionables vía TTS_PROVIDER (env var, resuelto una
  // sola vez a nivel de deployment, no por llamada) — decision-log.md
  // 2026-09-09, #19/#20. ELEVENLABS/OPENAI quedan sin usar, sin costo en
  // mantenerlos (YAGNI de borrarlos).
  OPENROUTER
}

// Modelos LLM intercambiables por persona/episodio (idea original, sección 4).
// Extensible: agregar un valor acá no requiere tocar ninguna otra entidad.
enum ModelProvider {
  OPENAI
  GOOGLE
  ANTHROPIC
  XAI
  OPENROUTER
}

enum AssetType {
  AUDIO_FULL
  VIDEO_LONG
  VIDEO_SHORT
  POST_X
}

// Inbox persistente que sobrevive a que el usuario no esté mirando la
// pantalla del episodio — complementa (no reemplaza) al SSE de
// EpisodeEventsService, que es en vivo/efímero (decision-log.md 2026-09-08,
// #9). Sin APPROVED/CANCELLED a propósito: el diseño aprobado solo notifica
// los 4 desenlaces donde el usuario necesita enterarse sin estar mirando.
enum NotificationType {
  EPISODE_COMPLETED
  EPISODE_PENDING_REVIEW
  EPISODE_REQUIRES_REVIEW
  EPISODE_FAILED
}

// =========================================================================
// 1. GESTIÓN DE TENDENCIAS E INVESTIGACIÓN
// =========================================================================

model Topic {
  id               String            @id @default(uuid())
  title            String // Ej: "La IA reemplazará a los programadores en 2026"
  context          String // Resumen inicial del trend descubierto o ingresado
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  researchSessions ResearchSession[]
  debates          Debate[]
}

model ResearchSession {
  id        String   @id @default(uuid())
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  rawOutput String // El reporte completo consolidado por tu ResearchProvider
  createdAt DateTime @default(now())
  sources   Source[]
}

model Source {
  id                String          @id @default(uuid())
  researchSessionId String
  researchSession   ResearchSession @relation(fields: [researchSessionId], references: [id], onDelete: Cascade)
  title             String
  url               String
  snippet           String // Fragmento de texto relevante extraído de la web

  // Feature 1: Recolección Extendida de Fuentes
  fetchTimestamp DateTime  @default(now())
  publishedAt    DateTime?
  contentHash    String // Identificador único del contenido recuperado para detectar mutaciones o duplicados

  // Relaciones
  facts      EvidenceFact[]
  factChecks FactCheck[]
}

model EvidenceFact {
  id        String   @id @default(uuid())
  sourceId  String
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  content   String // La afirmación o punto de datos fáctico extraído
  createdAt DateTime @default(now())
}

// =========================================================================
// 2. CONFIGURACIÓN DE AGENTES
// =========================================================================

model Agent {
  id           String     @id @default(uuid())
  name         String @unique // Ej: "IA_Elon", "Tech_Optimist"
  // String (no enum) a propósito: los "roles" de agente son un concepto de
  // negocio en evolución (Analyst/Contrarian/...), no una lista cerrada del
  // sistema como los status. Mantenerlo flexible para poder probar personas
  // nuevas sin migrar el schema.
  role         String? // Ej: "ANALYST", "CONTRARIAN", "JUDGE"
  avatarUrl    String? // Asset visual para Remotion
  // Snapshot informativo de la personalidad y las directrices del agente
  // (lo carga el seed). No se lee en runtime: el prompt real lo arma
  // AgentsService en cada llamada, con el idioma del episodio (spec 004,
  // D11), así que un mismo agente sirve para ES, EN y PT.
  systemPrompt String
  // Las voces viven en AgentVoice (una por idioma y proveedor), no en un
  // Json de Agent: ADR 0002, que reemplaza el punto 1 de decision-log.md #20.
  voices       AgentVoice[]
  arguments    Argument[]
  verdicts     Verdict[] // En caso de que este agente actúe como Juez
  episodeParticipations EpisodeParticipant[]
}

// ADR 0002 punto 2: la voz de un agente para un idioma y un AudioProvider.
// Los catálogos de los proveedores son incompatibles entre sí (nombre de
// modelo Piper vs. código de idioma de Google), por eso la clave incluye el
// proveedor. Que falte la fila es la única forma de representar "sin voz"
// (punto 3, spec 004 D14): nunca placeholders como "TBD".
model AgentVoice {
  agentId  String
  agent    Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  language DebateLanguage
  provider AudioProvider
  voiceId  String

  @@id([agentId, language, provider])
}

// =========================================================================
// 3. ORQUESTACIÓN DEL DEBATE
// =========================================================================

model Debate {
  id        String        @id @default(uuid())
  topicId   String
  topic     Topic         @relation(fields: [topicId], references: [id])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  rounds    DebateRound[]
  verdict   Verdict?
  verdictHistory VerdictHistory[]
  episode   Episode?
}

model DebateRound {
  id          String              @id @default(uuid())
  debateId    String
  debate      Debate              @relation(fields: [debateId], references: [id], onDelete: Cascade)
  round       Int // Número de ronda (ej: 1, 2, 3)
  type        RoundType
  arguments   Argument[]
  checkpoints EpisodeCheckpoint[] // Checkpoints que se congelaron durante esta ronda

  // debate.verdict.stale (spec 003, API-19): DebateService.isVerdictStale
  // busca las rondas del debate en cada GET /episodes/:id.
  @@index([debateId])
}

model Argument {
  id            String      @id @default(uuid())
  debateRoundId String
  debateRound   DebateRound @relation(fields: [debateRoundId], references: [id], onDelete: Cascade)
  agentId       String
  agent         Agent       @relation(fields: [agentId], references: [id])
  content       String // El texto generado por el LLM para este agente

  // Feature 6: Abstracción de AudioAsset (reemplaza audioUrl y audioDuration)
  audioAssetId String?     @unique
  audioAsset   AudioAsset? @relation(fields: [audioAssetId], references: [id])

  // Feature 3: Promoción de borradores y trazabilidad de mutaciones
  status ArgumentStatus @default(DRAFT)
  origin ArgumentOrigin @default(AI_GENERATED)

  // CROSS_EXAMINATION: apunta al argumento puntual que se está respondiendo.
  // Null en OPENING / REBUTTAL.
  respondsToId String?
  respondsTo   Argument?  @relation("ArgumentResponses", fields: [respondsToId], references: [id])
  responses    Argument[] @relation("ArgumentResponses")

  createdAt DateTime          @default(now())
  claims    Claim[]
  history   ArgumentHistory[]
}

model ArgumentHistory {
  id         String                 @id @default(uuid())
  argumentId String
  argument   Argument               @relation(fields: [argumentId], references: [id], onDelete: Cascade)
  content    String
  origin     ArgumentOrigin
  status     ArgumentHistoryStatus
  createdAt  DateTime               @default(now())

  // debate.verdict.stale (spec 003, API-19): DebateService.isVerdictStale
  // filtra por argumento y createdAt en cada GET /episodes/:id.
  @@index([argumentId, createdAt])
}

model Claim {
  id         String   @id @default(uuid())
  argumentId String
  argument   Argument @relation(fields: [argumentId], references: [id], onDelete: Cascade)
  statement  String // La afirmación específica que requiere verificación

  // Feature 3: Claim Extraction
  type ClaimType @default(FACTUAL)

  factCheck FactCheck?
}

model FactCheck {
  id        String            @id @default(uuid())
  claimId   String            @unique
  claim     Claim             @relation(fields: [claimId], references: [id], onDelete: Cascade)
  veracity  FactCheckVeracity
  analysis  String // Explicación/Justificación del Fact Checker
  createdAt DateTime          @default(now())

  // Feature 10: Vinculación con las fuentes de origen para auditoría
  sources Source[]
}

model Verdict {
  id        String   @id @default(uuid())
  debateId  String   @unique
  debate    Debate   @relation(fields: [debateId], references: [id], onDelete: Cascade)
  judgeId   String // El agente que tomó el rol de juez
  judge     Agent    @relation(fields: [judgeId], references: [id])
  content   String // Argumentación final del veredicto
  winnerId  String? // Id del Agent ganador (opcional)
  createdAt DateTime @default(now())
}

// Spec 003, API-19 (D17): veredictos reemplazados por `regenerate-verdict`.
// Feature 10: no se descarta lo que produjo la IA. Una fila por reemplazo,
// escrita en la misma transacción que borra el Verdict viejo y crea el nuevo
// (DebateService.replaceVerdict). No se expone en la API.
// judgeId y winnerId sin FK a Agent a propósito: es un archivo (igual que
// Verdict.winnerId) y así la reconstrucción de Agent de la spec 004
// (tasks.md §13.4) no tiene que recrear otra FK.
model VerdictHistory {
  id           String   @id @default(uuid())
  debateId     String
  debate       Debate   @relation(fields: [debateId], references: [id], onDelete: Cascade)
  judgeId      String
  content      String
  winnerId     String?
  issuedAt     DateTime // Verdict.createdAt del veredicto archivado
  supersededAt DateTime @default(now())
}

// =========================================================================
// 4. ENTREGABLE FINAL (PRODUCCIÓN AUDIOVISUAL) & LIFE-CYCLE
// =========================================================================

model Episode {
  id       String @id @default(uuid())
  debateId String @unique
  debate   Debate @relation(fields: [debateId], references: [id], onDelete: Cascade)
  title    String // Título del episodio para YouTube/TikTok

  // Render Config para el Cliente (Json nativo, soportado en SQLite desde Prisma 6.2)
  remotionManifest Json?

  // Feature 4: única fuente de verdad del ciclo de vida (v1.2)
  status EpisodeStatus @default(CREATED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Spec 003, API-7a: cuándo se publicó en el showcase. null = no
  // publicado. Nadie la escribe todavía: la escriben las acciones
  // publish/unpublish de API-7 cuando existan.
  publishedAt DateTime?

  // Spec 004 (D1, D3): idioma del debate, se fija al crear el episodio y no
  // cambia. Los episodios anteriores a la migración quedan en ES (AC 4.5).
  language DebateLanguage @default(ES)

  // Feature 2: Límites Operacionales por Episodio
  maxLlmCalls         Int @default(25)
  maxSearchQueries    Int @default(5)
  maxTtsSegments      Int @default(40)
  maxRevisionAttempts Int @default(3)

  // Configuración de rondas (configurable por episodio, no un valor fijo del sistema)
  openingRounds          Int @default(1)
  rebuttalRounds         Int @default(1)
  crossExaminationRounds Int @default(1)

  // Relaciones
  usage         EpisodeUsage?
  checkpoints   EpisodeCheckpoint[] // Historial completo, no se pisa (Feature 10)
  assets        Asset[]
  participants  EpisodeParticipant[]
  notifications Notification[]
}

// Quiénes debaten este episodio y con qué modelo LLM los interpreta —
// tanto la selección de personas como el modelo son datos por-episodio,
// no una configuración fija del sistema (rotan).
model EpisodeParticipant {
  id            String        @id @default(uuid())
  episodeId     String
  episode       Episode       @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  agentId       String
  agent         Agent         @relation(fields: [agentId], references: [id])
  modelProvider ModelProvider
  isJudge       Boolean       @default(false) // true para exactamente 1 participante por episodio

  @@unique([episodeId, agentId])
}

model EpisodeUsage {
  id             String  @id @default(uuid())
  episodeId      String  @unique
  episode        Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  llmCalls       Int     @default(0)
  inputTokens    Int     @default(0)
  outputTokens   Int     @default(0)
  searchRequests Int     @default(0)
  ttsRequests    Int     @default(0)
  executionTime  Int     @default(0)
}

model EpisodeCheckpoint {
  id        String           @id @default(uuid())
  episodeId String
  episode   Episode          @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  fromState EpisodeStatus // El estado en el que se congeló (ej: RESEARCHING, DEBATING)
  reason    CheckpointReason

  // Granularidad fina para retomar exactamente donde quedó dentro de DEBATING.
  // Null cuando la interrupción ocurrió fuera de una ronda (ej: RESEARCHING).
  debateRoundId String?
  debateRound   DebateRound? @relation(fields: [debateRoundId], references: [id])

  snapshot  String // JSON con la foto del EpisodeUsage y contexto relevante
  createdAt DateTime @default(now())

  // El checkpoint "activo" es el más reciente por createdAt — no hay flag
  // booleano redundante que pueda desincronizarse.
}

model AudioAsset {
  id         String         @id @default(uuid())
  storageKey String // ej: "episodes/45/segment_12.mp3"
  provider   AudioProvider
  durationMs Int
  mimeType   String // audio/mpeg

  // Feature 7: timing por palabra para los subtítulos del RemotionManifest
  // (timeline[].subtitles). Array<{ text, startMs, endMs }>, Json porque no
  // todo AudioProvider lo produce nativamente (Google/OpenRouter, en
  // backlog) — null cuando el proveedor activo no lo expone. Solo LOCAL
  // (echogarden) lo llena hoy (decision-log.md 2026-09-14/2026-09-24, #26/#27).
  subtitles Json?

  // ADR 0002 punto 6: la voz realmente usada al sintetizar, para que el
  // manifest de un episodio ya sintetizado no cambie si después se modifica
  // el seed. La migración de la spec 004 completó los assets existentes con
  // la voz LOCAL que tenía su agente (pregunta B); null = no se sabe cuál
  // se usó, y el manifest informa null (spec 004, D17 revisado: nunca
  // resuelve por idioma).
  voiceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  arguments Argument[]
}

model Asset {
  id        String    @id @default(uuid())
  episodeId String
  episode   Episode   @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  type      AssetType
  url       String // Ruta local o URL final del archivo renderizado/generado
  createdAt DateTime  @default(now())
}

// Acoplada 1:1 a Episode a propósito — no genérica/polimórfica. No hay hoy
// ningún otro emisor de notificaciones en el sistema, generalizar sin un
// caso concreto sería resolver un problema hipotético (decision-log.md
// 2026-09-08, #9). Sin checkpointId: alcanza con episodeId + message para
// el MVP, el frontend resuelve el detalle con GET /episodes/:id al click.
model Notification {
  id        String           @id @default(uuid())
  episodeId String
  episode   Episode          @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String // Texto ya armado al crear la fila, no derivado en el front
  readAt    DateTime? // null = no leída — mismo patrón que EpisodeCheckpoint (el más reciente es el vigente), sin flag booleano redundante
  createdAt DateTime         @default(now())

  @@index([episodeId, readAt])
}

// =========================================================================
// 5. INFRAESTRUCTURA DE LLM (rate limiting)
// =========================================================================

// Una fila por llamada real a un LLM, usada por LlmRateLimiterService para
// calcular RPM/RPD como ventana deslizante (COUNT sobre este log), no como
// contadores agregados con reset explícito — evita el punto ciego de un
// burst en el borde de dos ventanas fijas (decision-log.md 2026-09-08, #8).
model LlmRequestLog {
  id          String        @id @default(uuid())
  provider    ModelProvider
  requestedAt DateTime      @default(now())

  @@index([provider, requestedAt])
}
