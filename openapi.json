    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "episodes",
      "description": "Orquestación del pipeline y curaduría humana (api-contract.md §2/§3)"
    },
    {
      "name": "notifications",
      "description": "Inbox interno de notificaciones (Feature 4)"
    }
  ],
  "servers": [],
