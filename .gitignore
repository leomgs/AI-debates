# spec 002 (docs/product/002-workspace-restructure.md) — monorepo: cada
# apps/*/packages/* tiene su propio node_modules/dist, sin `/` de prefijo
# para que matcheen a cualquier profundidad (a diferencia del repo pre-002,
# donde todo colgaba de la raíz).
apps/*/node_modules
apps/*/dist
apps/*/.next
packages/*/node_modules
packages/*/dist
.turbo

# compiled output (paquetes sin apps/*/packages/* — no debería haber ya,
# se deja como red de seguridad)
/dist
/node_modules
/build

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output
apps/*/coverage

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

/generated/prisma

# DB local de desarrollo de apps/api (SQLite) — se regenera con
# prisma migrate deploy + db:seed, nunca se versiona (setup.md §2).
apps/api/dev.db

# DBs de test temporales de apps/api (aisladas de dev.db — ver
# test/jest-e2e.setup.ts y episodes.integration.spec.ts)
apps/api/test/tmp-e2e.db*
apps/api/src/modules/episodes/tmp-episodes-integration.db*

# Audio generado por TtsModule de apps/api (AC 6.1) — binarios regenerables
# desde AudioAsset + resíntesis, nunca se versionan (decision-log.md
# 2026-09-09, #20)
apps/api/outputs
